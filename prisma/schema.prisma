generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}


model User {
  id                    String        @id @default(uuid())
  walletAddress         String        @unique
  privyUserId           String?       @unique
  username              String?
  email                 String?       @unique
  phone                 String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  preferences           Json?
  
  // Coinbase Agent Wallet
  agentWalletAddress    String?
  agentWalletCreatedAt  DateTime?

  // Relations
  wallets       Wallet[]
  handles       Handle[]
  paymentLinks  PaymentLink[] @relation("UserPaymentLinks")
  paymentsSent  Payment[]     @relation("PaymentsSent")
  paymentsRecv  Payment[]     @relation("PaymentsRecv")
}

model Wallet {
  id        String     @id @default(uuid())
  userId    String
  address   String
  chainId   Int
  type      WalletType
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handles Handle[]

  @@unique([address, chainId])
  @@index([userId])
}

enum WalletType {
  EMBEDDED
  EXTERNAL
}

model Handle {
  id              String   @id @default(uuid())
  userId          String
  handle          String   @unique
  defaultWalletId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultWallet Wallet? @relation(fields: [defaultWalletId], references: [id], onDelete: SetNull)
  paymentLinks  PaymentLink[]

  @@index([userId])
  @@index([defaultWalletId])
}

model PaymentLink {
  id           String            @id @default(uuid())
  creatorId    String
  handleId     String?
  slug         String            @unique
  amount       Decimal?          @db.Decimal(38, 18)
  tokenAddress String
  tokenSymbol  String
  chainId      Int
  description  String?
  expiresAt    DateTime?
  maxUses      Int?
  usedCount    Int               @default(0)
  status       PaymentLinkStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  creator  User    @relation("UserPaymentLinks", fields: [creatorId], references: [id], onDelete: Cascade)
  handle   Handle? @relation(fields: [handleId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([creatorId])
  @@index([handleId])
  @@index([status])
  @@index([expiresAt])
}

enum PaymentLinkStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model Payment {
  id            String        @id @default(uuid())
  senderId      String?
  receiverId    String?
  paymentLinkId String?
  chainId       Int
  tokenAddress  String
  tokenSymbol   String
  amount        Decimal       @db.Decimal(38, 18)
  txHash        String?       @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sender      User?       @relation("PaymentsSent", fields: [senderId], references: [id], onDelete: SetNull)
  receiver    User?       @relation("PaymentsRecv", fields: [receiverId], references: [id], onDelete: SetNull)
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([paymentLinkId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}
